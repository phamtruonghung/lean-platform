# Local development only. Production configuration lives on the LXC and in
# GitHub repository variables and secrets, never in this repository.
#
#     cp .env.example .env

POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=platform

# pgAdmin, for browsing the local Postgres above in a browser
# (http://localhost:5052). Local-only development credentials, like
# everything else on this page: production uses self-hosted PostgreSQL on
# LXC CT100 (ADR-0051), and pgAdmin doesn't run there at all.
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=change-me-locally

# Where the backend finds Postgres when it is run outside Compose — running the
# test suite, for instance. Inside Compose this is set by docker-compose.yml.
# In production (VIProd) this is the connection string of the self-hosted
# PostgreSQL on LXC CT100, supplied by the Release workflow from the repository
# secret DATABASE_URL. A Supabase deployment (home LXC 150) uses Supabase's.
DATABASE_URL=postgresql://platform:change-me-locally@127.0.0.1:5434/platform

# Supabase Auth (ADR-0002; AUTH_PASSWORD_MODE=supabase only, not used by
# production, which runs 'local' - ADR-0051). The backend verifies a Supabase-issued session JWT
# against the project's own JWKS — src/platform/tokens.js. Find these on the
# Supabase dashboard under Project Settings > API:
#   SUPABASE_JWKS_URL    = ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   SUPABASE_JWT_ISSUER  = ${SUPABASE_URL}/auth/v1
# SUPABASE_JWT_AUDIENCE defaults to 'authenticated' (Supabase's own default
# for a signed-in user) and rarely needs overriding.
#
# None of this has a working local default: the integration test suite points
# these at a JWKS it serves itself from a locally generated key pair (see
# backend/test/helpers/jwks.js) rather than depending on a real Supabase
# project, so the test suite passes on a clean checkout with nothing filled
# in here. Running the backend for real sign-in needs a real Supabase project.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Which door authenticates a bearer token (issue #268). 'supabase' (default)
# verifies a Supabase JWT as above; 'local' signs people in with an email and a
# password held in this deployment's own PostgreSQL (POST /api/auth/login) and
# resolves the session token it returns. Unset means supabase. On a deployment
# this comes from the Release workflow's repository variable AUTH_PASSWORD_MODE,
# not from this file: a runner deploy does not read the box's .env.
# AUTH_PASSWORD_MODE=supabase

# Supabase Auth, client side. The Flutter app signs in against Supabase
# directly (ADR-0002) — these are public by design (an anon key is meant to
# ship in a browser bundle) and are baked in at build time via --dart-define,
# not read from this file at runtime. `flutter run`/`flutter build web` take
# them directly as --dart-define=SUPABASE_URL=...; frontend/Dockerfile takes
# them as the matching --build-arg and forwards them to the same flags. See
# frontend/lib/supabase_config.dart.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The MTU KPI catalogue (ADR-0055): a second database, `mtu` (schema `kpi`),
# on another host, shared with Power BI. The API reaches it through its own
# connection pool as the role lean_app, which can read it and append to it and
# nothing else. Unset means the KPI catalogue is unavailable on this
# deployment: every /api/kpi/* route answers 503 and the rest of the API is
# unaffected. On VIProd the connection string is written to
# /root/.mtu-kpi/lean_app.env on CT100. The value below is a placeholder, not a
# credential:
# MTU_DATABASE_URL=postgresql://lean_app:change-me-locally@127.0.0.1:5432/mtu
